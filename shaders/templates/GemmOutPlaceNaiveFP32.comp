#version 460
#extension GL_EXT_control_flow_attributes: enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_ballot: enable
#extension GL_KHR_shader_subgroup_arithmetic: enable

/*
 * Streaming execution and tiling hierarchy
 * =================================
 *
 * Dispatch
 *   gl_WorkGroupID.x : batch index
 *   gl_WorkGroupID.y : C workgroup-tile index on the M axis
 *   gl_WorkGroupID.z : C workgroup-tile index on the P axis
 *
 * Workgroup
 *   local size = threadgroup_tile_m * threadgroup_tile_p invocations
 *   threadgroup_tile_m = subgroup_tile_cnt_m * subgroup_tile_m
 *   threadgroup_tile_p = subgroup_tile_cnt_p * subgroup_tile_p
 *   subgroup count =
 *       subgroup_tile_cnt_m * subgroup_tile_cnt_p
 *   workgroup C rows =
 *       subgroup_tile_cnt_m * subgroup_tile_m * reg_tile_m
 *   workgroup C cols =
 *       subgroup_tile_cnt_p * subgroup_tile_p * reg_tile_p
 *
 *   The entire workgroup cooperatively loads:
 *     ATs[shared N][workgroup M]
 *     Bs [shared N][workgroup P]
 *
 *   gl_LocalInvocationIndex is used only to distribute these loads. Shared
 *   loading is deliberately independent of subgroup ownership.
 *
 * Subgroup grid
 *   subgroup_m_id = gl_SubgroupID % subgroup_tile_cnt_m
 *   subgroup_p_id = gl_SubgroupID / subgroup_tile_cnt_m
 *
 *   Each subgroup owns a unique C tile:
 *     subgroup C rows = subgroup_tile_m * reg_tile_m
 *     subgroup C cols = subgroup_tile_p * reg_tile_p
 *
 * Lane grid inside one subgroup
 *   lane_m = gl_SubgroupInvocationID % subgroup_tile_m
 *   lane_p = gl_SubgroupInvocationID / subgroup_tile_m
 *
 *   Each lane owns one contiguous register tile:
 *     acc[reg_tile_m][reg_tile_p]
 *
 *   Its workgroup-local C origin is:
 *     M = subgroup_m_id * subgroup_tile_m * reg_tile_m
 *         + lane_m * reg_tile_m
 *     P = subgroup_p_id * subgroup_tile_p * reg_tile_p
 *         + lane_p * reg_tile_p
 *
 * N-axis pipeline
 *   streamed K unroll = k_unroll
 *   shared N tile =
 *       shared_tile_n_multiplier * subgroup_tile_n * k_unroll
 *
 *   1. The workgroup loads one large A/B shared tile.
 *   2. barrier() makes the tile visible to every subgroup.
 *   3. For each K, every subgroup reads only the current A/B values, exchanges
 *      them with subgroupShuffle(), and immediately updates its C register tile.
 *   4. barrier() prevents the next iteration from overwriting shared memory
 *      while another subgroup is still reading it.
 *
 * Specialization invariants
 *   subgroup_tile_m * subgroup_tile_p == gl_SubgroupSize == 32
 *   k_unroll > 0
 *   threadgroup_tile_m * threadgroup_tile_p
 *       == subgroup_tile_cnt_m * subgroup_tile_cnt_p * gl_SubgroupSize
 */

// Variable links (For simple implementation of contiguous kernels)
#define A_STRIDE args.a_stride
#define B_STRIDE args.b_stride
#define C_STRIDE args.c_stride
#define A_M_STRIDE args.a_m_stride
#define A_N_STRIDE args.a_n_stride
#define B_N_STRIDE args.b_n_stride
#define B_P_STRIDE args.b_p_stride
#define C_M_STRIDE args.c_m_stride
#define C_P_STRIDE args.c_p_stride
#define OUT_C_STRIDE args.out_c_stride
#define OUT_C_M_STRIDE args.out_c_m_stride
#define OUT_C_P_STRIDE args.out_c_p_stride

// Specialized Constants
layout(constant_id = 0) const uint shared_tile_n_multiplier = 2;
layout(constant_id = 1) const uint subgroup_tile_cnt_m = 2;
layout(constant_id = 2) const uint subgroup_tile_cnt_p = 2;
layout(constant_id = 3) const uint subgroup_tile_m = 8;
layout(constant_id = 4) const uint subgroup_tile_n = 4;
layout(constant_id = 5) const uint subgroup_tile_p = 4;
layout(constant_id = 6) const uint threadgroup_tile_m = 16; // subgroup_tile_cnt_m * subgroup_tile_m
layout(constant_id = 7) const uint threadgroup_tile_p = 8;  // subgroup_tile_cnt_p * subgroup_tile_p
layout(constant_id = 8) const uint reg_tile_m = 8;
layout(constant_id = 9) const uint k_unroll = 8;
layout(constant_id = 10) const uint reg_tile_p = 8;
const uint shared_tile_m_multiplier = subgroup_tile_cnt_m;
const uint shared_tile_p_multiplier = subgroup_tile_cnt_p;

layout(local_size_x_id = 6, local_size_y_id = 7, local_size_z = 1) in;

// d := alpha * A * B + beta * C
layout(set = 0, binding = 0) readonly restrict buffer tensor_a {
    float a[];
};

layout(set = 0, binding = 1) readonly restrict buffer tensor_b {
    float b[];
};

layout(set = 0, binding = 2) readonly restrict buffer tensor_c {
    float c[];
};

layout(set = 0, binding = 3) writeonly restrict buffer tensor_d {
    float d[];
};

layout( push_constant ) uniform constants {
    uint batch;
    uint m;
    uint n;
    uint p;
    float alpha;
    float beta;
    uint a_stride;
    uint b_stride;
    uint c_stride;
    uint a_m_stride;
    uint a_n_stride;
    uint b_n_stride;
    uint b_p_stride;
    uint c_m_stride;
    uint c_p_stride;
    uint out_c_stride;
    uint out_c_m_stride;
    uint out_c_p_stride;
} args;

/*__VUBLAS_EPILOGUE__*/

const uint shared_as_row_size = shared_tile_m_multiplier * subgroup_tile_m * reg_tile_m;
const uint shared_as_col_size = shared_tile_n_multiplier * subgroup_tile_n * k_unroll;
const uint shared_bs_row_size = shared_tile_n_multiplier * subgroup_tile_n * k_unroll;
const uint shared_bs_col_size = shared_tile_p_multiplier * subgroup_tile_p * reg_tile_p;
const uint subgroup_lane_count = subgroup_tile_m * subgroup_tile_p;

// This shader follows row-major, so col-major is transposed one.
shared float ATs[shared_as_col_size][shared_as_row_size];
shared float Bs[shared_bs_row_size][shared_bs_col_size];

// Index calculation
uint div_ceil(uint value, uint divisor){
    return value / divisor + (value % divisor == 0 ? 0 : 1);
}

uint get_batch_id(){
    return gl_WorkGroupID.x;
}

uint get_a_idx(uint batch_id, uint m, uint n){
    return batch_id * A_STRIDE + m * A_M_STRIDE + n * A_N_STRIDE;
}

uint get_b_idx(uint batch_id, uint n, uint p){
    return batch_id * B_STRIDE + n * B_N_STRIDE + p * B_P_STRIDE;
}

uint get_c_idx(uint batch_id, uint m, uint p){
    return batch_id * C_STRIDE + m * C_M_STRIDE + p * C_P_STRIDE;
}

uint get_out_c_idx(uint batch_id, uint m, uint p){
    return
        batch_id * OUT_C_STRIDE +
        m * OUT_C_M_STRIDE +
        p * OUT_C_P_STRIDE;
}

uint get_workgroup_invocation_count(){
    return gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;
}

uint get_workgroup_m_offset(){
    return gl_WorkGroupID.y * shared_as_row_size;
}

uint get_workgroup_p_offset(){
    return gl_WorkGroupID.z * shared_bs_col_size;
}

uint get_shared_tile_n_offset(uint shared_tile_n_id){
    return shared_tile_n_id * shared_as_col_size;
}

uint get_subgroup_m_id(){
    return gl_SubgroupID % subgroup_tile_cnt_m;
}

uint get_subgroup_p_id(){
    return gl_SubgroupID / subgroup_tile_cnt_m;
}

uint get_subgroup_m_offset(){
    return get_subgroup_m_id() * subgroup_tile_m * reg_tile_m;
}

uint get_subgroup_p_offset(){
    return get_subgroup_p_id() * subgroup_tile_p * reg_tile_p;
}

uint get_lane_m(){
    return gl_SubgroupInvocationID % subgroup_tile_m;
}

uint get_lane_p(){
    return gl_SubgroupInvocationID / subgroup_tile_m;
}

uint get_lane_m_offset(){
    return get_lane_m() * reg_tile_m;
}

uint get_lane_p_offset(){
    return get_lane_p() * reg_tile_p;
}

uint get_lane_tile_m_offset(){
    return get_subgroup_m_offset() + get_lane_m_offset();
}

uint get_lane_tile_p_offset(){
    return get_subgroup_p_offset() + get_lane_p_offset();
}

uint get_global_lane_tile_m_offset(){
    return get_workgroup_m_offset() + get_lane_tile_m_offset();
}

uint get_global_lane_tile_p_offset(){
    return get_workgroup_p_offset() + get_lane_tile_p_offset();
}

uvec2 get_a_shared_coord(uint element_id){
    // x: M, y: N
    return uvec2(
        element_id / shared_as_col_size,
        element_id % shared_as_col_size);
}

uvec2 get_b_shared_coord(uint element_id){
    // x: N, y: P
    return uvec2(
        element_id / shared_bs_col_size,
        element_id % shared_bs_col_size);
}

uvec2 get_a_global_coord(
    uint shared_tile_n_id,
    uvec2 shared_coord){
    // x: M, y: N
    return uvec2(
        get_workgroup_m_offset() + shared_coord.x,
        get_shared_tile_n_offset(shared_tile_n_id) + shared_coord.y);
}

uvec2 get_b_global_coord(
    uint shared_tile_n_id,
    uvec2 shared_coord){
    // x: N, y: P
    return uvec2(
        get_shared_tile_n_offset(shared_tile_n_id) + shared_coord.x,
        get_workgroup_p_offset() + shared_coord.y);
}

// Loaders
void load_a_shared(uint shared_tile_n_id){
    const uint batch_id = get_batch_id();
    const uint workgroup_size = get_workgroup_invocation_count();
    const uint element_count = shared_as_row_size * shared_as_col_size;

    for(uint element_id = gl_LocalInvocationIndex;
        element_id < element_count;
        element_id += workgroup_size){
        // Iterate over A as [M][N] for contiguous global-memory reads, then
        // transpose it while writing to shared memory.
        const uvec2 shared_coord = get_a_shared_coord(element_id);
        const uvec2 global_coord =
            get_a_global_coord(shared_tile_n_id, shared_coord);

        float value = 0.0f;
        if(batch_id < args.batch &&
           global_coord.x < args.m &&
           global_coord.y < args.n){
            value = a[get_a_idx(batch_id, global_coord.x, global_coord.y)];
        }
        ATs[shared_coord.y][shared_coord.x] = value;
    }
}

void load_b_shared(uint shared_tile_n_id){
    const uint batch_id = get_batch_id();
    const uint workgroup_size = get_workgroup_invocation_count();
    const uint element_count = shared_bs_row_size * shared_bs_col_size;

    for(uint element_id = gl_LocalInvocationIndex;
        element_id < element_count;
        element_id += workgroup_size){
        const uvec2 shared_coord = get_b_shared_coord(element_id);
        const uvec2 global_coord =
            get_b_global_coord(shared_tile_n_id, shared_coord);

        float value = 0.0f;
        if(batch_id < args.batch &&
           global_coord.x < args.n &&
           global_coord.y < args.p){
            value = b[get_b_idx(batch_id, global_coord.x, global_coord.y)];
        }
        Bs[shared_coord.x][shared_coord.y] = value;
    }
}

void load_shared_tile(uint shared_tile_n_id){
    load_a_shared(shared_tile_n_id);
    load_b_shared(shared_tile_n_id);
    barrier();
}

// Accumulation
void initialize_accumulator(
    out float acc[reg_tile_m][reg_tile_p]){
    [[unroll]]
    for(uint rti_m = 0; rti_m < reg_tile_m; rti_m++){
        [[unroll]]
        for(uint rti_p = 0; rti_p < reg_tile_p; rti_p++){
            acc[rti_m][rti_p] = 0.0f;
        }
    }
}

void stream_a_values(
    uint shared_n,
    out float a_values[reg_tile_m]){
    const uint source_lane_p = shared_n % subgroup_tile_p;
    const uint source_lane =
        get_lane_m() + source_lane_p * subgroup_tile_m;
    const uint shared_m_offset = get_lane_tile_m_offset();
    const bool is_source_lane = get_lane_p() == source_lane_p;

    [[unroll]]
    for(uint rti_m = 0; rti_m < reg_tile_m; rti_m++){
        float source_value = 0.0f;
        if(is_source_lane){
            source_value = ATs[shared_n][shared_m_offset + rti_m];
        }
        a_values[rti_m] = subgroupShuffle(source_value, source_lane);
    }
}

void stream_b_values(
    uint shared_n,
    out float b_values[reg_tile_p]){
    const uint source_lane_m = shared_n % subgroup_tile_m;
    const uint source_lane =
        source_lane_m + get_lane_p() * subgroup_tile_m;
    const uint shared_p_offset = get_lane_tile_p_offset();
    const bool is_source_lane = get_lane_m() == source_lane_m;

    [[unroll]]
    for(uint rti_p = 0; rti_p < reg_tile_p; rti_p++){
        float source_value = 0.0f;
        if(is_source_lane){
            source_value = Bs[shared_n][shared_p_offset + rti_p];
        }
        b_values[rti_p] = subgroupShuffle(source_value, source_lane);
    }
}

void accumulate_streamed_k(
    uint shared_n,
    inout float acc[reg_tile_m][reg_tile_p]){
    float a_values[reg_tile_m];
    float b_values[reg_tile_p];

    stream_a_values(shared_n, a_values);
    stream_b_values(shared_n, b_values);

    [[unroll]]
    for(uint rti_m = 0; rti_m < reg_tile_m; rti_m++){
        [[unroll]]
        for(uint rti_p = 0; rti_p < reg_tile_p; rti_p++){
            acc[rti_m][rti_p] =
                fma(a_values[rti_m], b_values[rti_p], acc[rti_m][rti_p]);
        }
    }
}

void accumulate_shared_tile(
    inout float acc[reg_tile_m][reg_tile_p]){
    for(uint shared_n_base = 0;
        shared_n_base < shared_as_col_size;
        shared_n_base += k_unroll){
        [[unroll]]
        for(uint ki = 0; ki < k_unroll; ki++){
            accumulate_streamed_k(shared_n_base + ki, acc);
        }
    }
}

void accumulate_all_shared_tiles(
    inout float acc[reg_tile_m][reg_tile_p]){
    const uint shared_tile_n_count = div_ceil(args.n, shared_as_col_size);

    for(uint shared_tile_n_id = 0;
        shared_tile_n_id < shared_tile_n_count;
        shared_tile_n_id++){
        load_shared_tile(shared_tile_n_id);
        accumulate_shared_tile(acc);

        // No subgroup may overwrite the shared tile until every subgroup has
        // finished consuming it.
        barrier();
    }
}

// Writeback
void write_accumulator(
    in float acc[reg_tile_m][reg_tile_p]){
    const uint batch_id = get_batch_id();
    const uint global_m_offset = get_global_lane_tile_m_offset();
    const uint global_p_offset = get_global_lane_tile_p_offset();

    if(batch_id >= args.batch){
        return;
    }

    [[unroll]]
    for(uint rti_m = 0; rti_m < reg_tile_m; rti_m++){
        const uint global_m = global_m_offset + rti_m;
        if(global_m >= args.m){
            continue;
        }

        [[unroll]]
        for(uint rti_p = 0; rti_p < reg_tile_p; rti_p++){
            const uint global_p = global_p_offset + rti_p;
            if(global_p < args.p){
                const uint c_idx = get_c_idx(batch_id, global_m, global_p);
                const uint out_c_idx =
                    get_out_c_idx(batch_id, global_m, global_p);
                const float value = fma(
                    args.alpha,
                    acc[rti_m][rti_p],
                    args.beta * c[c_idx]);
                d[out_c_idx] = epilogue(value);
            }
        }
    }
}

// Main function
void main(){
    // Specialization requirements:
    // 1. subgroup_tile_m * subgroup_tile_p == gl_SubgroupSize == 32.
    // 2. The workgroup contains subgroup_tile_cnt_m * subgroup_tile_cnt_p
    //    full subgroups.
    float acc[reg_tile_m][reg_tile_p];

    initialize_accumulator(acc);
    accumulate_all_shared_tiles(acc);
    write_accumulator(acc);
}

